# Auth service
AUTH_PORT=3001
AUTH_SERVICE_NAME=auth
JWT_SECRET=jwt-secret-local
JWT_EXPIRES_IN=1d

# Passport service
PASSPORT_PORT=3002
PASSPORT_SERVICE_NAME=passport

# Auth service URL (used by Passport/Document to verify Bearer tokens over HTTP)
AUTH_SERVICE_URL=http://auth:3001

# Document service
DOCUMENT_PORT=3003
DOCUMENT_SERVICE_NAME=document

# Notification service
NOTIFICATION_PORT=3004
NOTIFICATION_SERVICE_NAME=notification

# Mailpit (local SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@battery-passport.local

# MongoDB
MONGO_URI=mongodb://mongodb:27017/battery-passport

# Kafka
KAFKA_BROKER=kafka:9092

# MinIO (S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=documents
